diff --git a/frontends/include/ecm_front_end_ipv4.h b/frontends/include/ecm_front_end_ipv4.h
--- a/frontends/include/ecm_front_end_ipv4.h
+++ b/frontends/include/ecm_front_end_ipv4.h
@@ -19,3 +19,3 @@
 extern int ecm_front_end_ipv4_stopped;	/* When non-zero further traffic will not be processed */
-extern atomic_t ecm_front_end_ipv4_stopped_temp;	/* When non-zero further traffic/process will not be processed where it is checked */
+extern void ecm_front_end_ipv4_stop_temp(int num);
 
diff --git a/frontends/include/ecm_front_end_ipv6.h b/frontends/include/ecm_front_end_ipv6.h
--- a/frontends/include/ecm_front_end_ipv6.h
+++ b/frontends/include/ecm_front_end_ipv6.h
@@ -19,3 +19,3 @@
 extern int ecm_front_end_ipv6_stopped;	/* When non-zero further traffic will not be processed */
-extern atomic_t ecm_front_end_ipv6_stopped_temp;	/* When non-zero further traffic/process will not be processed where it is checked */
+extern void ecm_front_end_ipv6_stop_temp(int num);
 
diff --git a/frontends/cmn/ecm_ipv4.c b/frontends/cmn/ecm_ipv4.c
--- a/frontends/cmn/ecm_ipv4.c
+++ b/frontends/cmn/ecm_ipv4.c
@@ -12,5 +12,6 @@
 #include <linux/tcp.h>
 #include <linux/module.h>
+#include <linux/atomic.h>
 #include <linux/skbuff.h>
 #include <linux/icmp.h>
 #include <linux/kthread.h>
@@ -96,7 +97,20 @@
  * NOTE: It is safe to take this lock WHILE HOLDING a feci->lock.  The reverse is NOT SAFE.
  */
 DEFINE_SPINLOCK(ecm_ipv4_lock);			/* Protect against SMP access between netfilter, events and private threaded function. */
+
+static atomic_t ecm_front_end_ipv4_stopped_temp = ATOMIC_INIT(0);
+
+void ecm_front_end_ipv4_stop_temp(int num)
+{
+	spin_lock_bh(&ecm_ipv4_lock);
+	if (num) {
+		atomic_inc(&ecm_front_end_ipv4_stopped_temp);
+	} else {
+		atomic_dec_if_positive(&ecm_front_end_ipv4_stopped_temp);
+	}
+	spin_unlock_bh(&ecm_ipv4_lock);
+}
 
 /*
  * Management thread control
  */
diff --git a/frontends/cmn/ecm_ipv6.c b/frontends/cmn/ecm_ipv6.c
