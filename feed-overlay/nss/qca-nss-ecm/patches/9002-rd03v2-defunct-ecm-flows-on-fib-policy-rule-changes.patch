From: RD03v2 AI-assisted development <ai-assisted@localhost>
Subject: [PATCH] ecm: defunct accelerated flows on FIB policy-rule changes

The v2 ECM tree already handles route-table updates, but a policy-rule-only
change made by mwan3 can move a flow to another WAN without a route event.
Defunct accelerated connections of the affected address family so their next
packets are routed using the current policy rules.

The FIB notifier callback is atomic, so it only sets a pending family bit and
queues work. The worker uses the v2 temporary frontend stop API around the
existing process-context connection defunct routine. The pinned QSDK source already uses atomic temporary-stop counters, but its
read-then-decrement sequence is not serialized with packet-hook checks. This
patch moves the counters beside the common frontend locks and uses a guarded
decrement, making stop updates atomic with the hooks' stop-state checks. After closing the gates, the worker calls
`synchronize_net()` to wait for pre-existing Netfilter hook readers before
walking the ECM database. Teardown unregisters the
notifier and drains the worker before the database is freed.

This is a broad invalidation: existing accelerated flows may briefly return to
the host path and be re-accelerated. It does not promise preservation of
conntrack/NAT sessions across a public-WAN change.

---
ecm_db/ecm_db.c | +197 -8
ecm_db/ecm_db.h | +1 -0
ecm_init.c | +4 -0
frontends/ecm_front_end_ipv4.c | +0 -17
frontends/ecm_front_end_ipv6.c | +0 -17
frontends/include/ecm_front_end_ipv4.h | +1 -1
frontends/include/ecm_front_end_ipv6.h | +1 -1
frontends/cmn/ecm_ipv4.c | +14 -0
frontends/cmn/ecm_ipv6.c | +14 -0
9 files changed, 232 insertions(+), 44 deletions(-)
diff --git a/ecm_db/ecm_db.c b/ecm_db/ecm_db.c
--- a/ecm_db/ecm_db.c
+++ b/ecm_db/ecm_db.c
@@ -22,5 +22,10 @@
 #include <asm/uaccess.h>	/* for put_user */
 #include <net/ipv6.h>
 #include <net/ip6_route.h>
+#include <net/fib_notifier.h>
+#include <linux/bitops.h>
+#include <linux/workqueue.h>
+#include <linux/rtnetlink.h>
+#include <linux/netdevice.h>
 #include <linux/inet.h>
 #include <linux/in.h>
@@ -78,9 +83,11 @@
 static int ecm_db_ipv4_route_enable = 1;
+static bool ecm_db_ipv4_route_registered;
 
 /*
  * Enable/Disable IPV6 routing table events
  */
 #ifdef ECM_IPV6_ENABLE
 static int ecm_db_ipv6_route_enable = 1;
+static bool ecm_db_ipv6_route_registered;
 #endif
 
@@ -469,9 +476,149 @@
 static struct notifier_block ecm_db_ip6route_table_update_nb = {
 	.notifier_call = ecm_db_ipv6_route_table_update_event,
 };
 #endif
 
+/*
+ * FIB policy-rule changes.
+ *
+ * mwan3 changes the policy rules when it changes WAN selection. A rule-only
+ * change does not necessarily generate a route-table notification, so ECM
+ * can otherwise keep an accelerated connection on its previous egress.
+ * FIB notifier callbacks run in atomic context: only record the address
+ * family here and defer connection defuncting to a work item.
+ */
+#define ECM_DB_FIB_RULE_PENDING_IPV4 0
+#ifdef ECM_IPV6_ENABLE
+#define ECM_DB_FIB_RULE_PENDING_IPV6 1
+#endif
+
+static unsigned long ecm_db_fib_rule_pending;
+static bool ecm_db_fib_rule_registered;
+
+/*
+ * ecm_db_fib_rule_work_fn()
+ * 	Defunct connections for every address family with a policy-rule change.
+ */
+static void ecm_db_fib_rule_work_fn(struct work_struct *work)
+{
+	bool ipv4_pending;
+	bool any_pending;
+#ifdef ECM_IPV6_ENABLE
+	bool ipv6_pending;
+#endif
+
+	(void)work;
+
+	/*
+	 * Live rule ADD/DEL changes run under init_net's per-net RTNL. Initial
+	 * register_fib_notifier() replay instead runs under RCU without RTNL.
+	 * Snapshot and clear pending bits under RTNL for live updates; atomic
+	 * pending bits and work re-queueing preserve replay events too.
+	 */
+	rtnl_net_lock(&init_net);
+	ipv4_pending = test_and_clear_bit(ECM_DB_FIB_RULE_PENDING_IPV4, &ecm_db_fib_rule_pending);
+#ifdef ECM_IPV6_ENABLE
+	ipv6_pending = test_and_clear_bit(ECM_DB_FIB_RULE_PENDING_IPV6, &ecm_db_fib_rule_pending);
+#endif
+	rtnl_net_unlock(&init_net);
+
+	any_pending = ipv4_pending;
+#ifdef ECM_IPV6_ENABLE
+	any_pending |= ipv6_pending;
+#endif
+
+	/*
+	 * Close every affected frontend before waiting, so new Netfilter hooks
+	 * cannot start ECM processing while pre-existing hooks are draining.
+	 */
+	if (ipv4_pending) {
+		ecm_front_end_ipv4_stop_temp(1);
+	}
+#ifdef ECM_IPV6_ENABLE
+	if (ipv6_pending) {
+		ecm_front_end_ipv6_stop_temp(1);
+	}
+#endif
+
+	/*
+	 * nf_hook() holds rcu_read_lock() across the complete hook chain.
+	 * synchronize_net() waits for those pre-existing readers to finish.
+	 * We dropped init_net's RTNL lock above, so this wait is sleepable.
+	 */
+	if (any_pending) {
+		synchronize_net();
+	}
+
+	if (ipv4_pending) {
+		DEBUG_TRACE("FIB rule update: defunct all IPv4 connections\n");
+		ecm_db_connection_defunct_ip_version(4);
+		ecm_front_end_ipv4_stop_temp(0);
+	}
+#ifdef ECM_IPV6_ENABLE
+	if (ipv6_pending) {
+		DEBUG_TRACE("FIB rule update: defunct all IPv6 connections\n");
+		ecm_db_connection_defunct_ip_version(6);
+		ecm_front_end_ipv6_stop_temp(0);
+	}
+#endif
+}
+
+static DECLARE_WORK(ecm_db_fib_rule_work, ecm_db_fib_rule_work_fn);
+
+/*
+ * ecm_db_fib_rule_event()
+ * 	Atomic FIB notifier callback: queue work for rule add/delete events.
+ */
+static int ecm_db_fib_rule_event(struct notifier_block *nb, unsigned long event, void *ptr)
+{
+	struct fib_notifier_info *info = ptr;
+
+	if (!info || ((event != FIB_EVENT_RULE_ADD) && (event != FIB_EVENT_RULE_DEL))) {
+		return NOTIFY_DONE;
+	}
+
+	switch (info->family) {
+	case AF_INET:
+		set_bit(ECM_DB_FIB_RULE_PENDING_IPV4, &ecm_db_fib_rule_pending);
+		break;
+#ifdef ECM_IPV6_ENABLE
+	case AF_INET6:
+		set_bit(ECM_DB_FIB_RULE_PENDING_IPV6, &ecm_db_fib_rule_pending);
+		break;
+#endif
+	default:
+		return NOTIFY_DONE;
+	}
+
+	schedule_work(&ecm_db_fib_rule_work);
+	return NOTIFY_DONE;
+}
+
+static struct notifier_block ecm_db_fib_rule_nb = {
+	.notifier_call = ecm_db_fib_rule_event,
+};
+
+/*
+ * ecm_db_fib_rule_notifier_stop()
+ * Stop FIB callbacks and drain pending work before front-end teardown.
+ */
+void ecm_db_fib_rule_notifier_stop(void)
+{
+	int ret;
+
+	if (ecm_db_fib_rule_registered) {
+		ret = unregister_fib_notifier(&init_net, &ecm_db_fib_rule_nb);
+		if (ret) {
+			DEBUG_ERROR("Could not unregister FIB rule notifier error:%d\n", ret);
+		} else {
+			ecm_db_fib_rule_registered = false;
+		}
+	}
+	cancel_work_sync(&ecm_db_fib_rule_work);
+}
+EXPORT_SYMBOL(ecm_db_fib_rule_notifier_stop);
+
 /*
  * ecm_db_defunct_all_handler()
  * 	Proc handler to defunct ecm db
  */
@@ -675,4 +822,5 @@
 int ecm_db_init(struct dentry *dentry)
 {
 	int ret = 0;
+	int route_ret = 0;
 
@@ -747,20 +895,56 @@
 	/*
 	 * register for route table modification events
 	 */
 	if (ecm_db_ipv4_route_enable) {
-		ret = ip_rt_register_notifier(&ecm_db_iproute_table_update_nb);
-		if (ret) {
-			DEBUG_ERROR("Could not register for the IPV4 routing events error:%d\n", ret);
+		route_ret = ip_rt_register_notifier(&ecm_db_iproute_table_update_nb);
+		if (route_ret) {
+			DEBUG_ERROR("Could not register for the IPV4 routing events error:%d\n", route_ret);
+			ret = route_ret;
+		} else {
+			ecm_db_ipv4_route_registered = true;
 		}
 	}
 
 #ifdef ECM_IPV6_ENABLE
 	if (ecm_db_ipv6_route_enable) {
-		ret = rt6_register_notifier(&ecm_db_ip6route_table_update_nb);
-		if (ret) {
-			DEBUG_ERROR("Could not register for the IPV6 routing events error:%d\n", ret);
+		route_ret = rt6_register_notifier(&ecm_db_ip6route_table_update_nb);
+		if (route_ret) {
+			DEBUG_ERROR("Could not register for the IPV6 routing events error:%d\n", route_ret);
+			if (!ret) {
+				ret = route_ret;
+			}
+		} else {
+			ecm_db_ipv6_route_registered = true;
 		}
 	}
 #endif
+
+	/* ecm_init() skips ecm_db_exit() at err_db; unwind the DB here. */
+	/* Do not register a FIB notifier if either route notifier failed. */
+	if (ret) {
+		ecm_db_exit();
+		return ret;
+	}
+
+	/*
+	 * Register for policy-rule modifications (used by mwan3 and other
+	 * policy-routing managers). Keep the route-notifier result in ret.
+	 * If FIB notifier registration fails, abort ECM module initialization:
+	 * ecm_db_init() runs before packet frontends and conntrack hooks start.
+	 */
+	{
+		int fib_ret;
+
+		fib_ret = register_fib_notifier(&init_net, &ecm_db_fib_rule_nb, NULL, NULL);
+		if (fib_ret) {
+			printk(KERN_ERR "ECM: FIB notifier registration failed (%d); aborting ECM initialization\n", fib_ret);
+			ecm_db_exit();
+			return fib_ret;
+		}
+
+		ecm_db_fib_rule_registered = true;
+		printk(KERN_INFO "ECM: policy routing rule changes defunct accelerated connections\n");
+	}
+
 	return ret;
 
@@ -785,3 +969,4 @@
 void ecm_db_exit(void)
 {
+	ecm_db_fib_rule_notifier_stop();
 	DEBUG_INFO("ECM DB Module exit\n");
@@ -795,19 +980,23 @@
 	/*
 	 * unregister for route table update events only if registered.
 	 */
-	if (ecm_db_ipv4_route_enable) {
+	if (ecm_db_ipv4_route_registered) {
 		ret = ip_rt_unregister_notifier(&ecm_db_iproute_table_update_nb);
 		if (ret) {
 			DEBUG_ERROR("Could not unregister for the IPV4 routing events error:%d\n", ret);
+		} else {
+			ecm_db_ipv4_route_registered = false;
 		}
 	}
 
 #ifdef ECM_IPV6_ENABLE
-	if (ecm_db_ipv6_route_enable) {
+	if (ecm_db_ipv6_route_registered) {
 		ret = rt6_unregister_notifier(&ecm_db_ip6route_table_update_nb);
 		if (ret) {
 			DEBUG_ERROR("Could not unregister for the IPV6 routing events error:%d\n", ret);
+		} else {
+			ecm_db_ipv6_route_registered = false;
 		}
 	}
 #endif
 	ecm_db_connection_defunct_all();
diff --git a/ecm_db/ecm_db.h b/ecm_db/ecm_db.h
--- a/ecm_db/ecm_db.h
+++ b/ecm_db/ecm_db.h
@@ -45,2 +45,3 @@
 int ecm_db_init(struct dentry *dentry);
+void ecm_db_fib_rule_notifier_stop(void);
 void ecm_db_exit(void);
diff --git a/ecm_init.c b/ecm_init.c
--- a/ecm_init.c
+++ b/ecm_init.c
@@ -307,2 +307,3 @@
 err_ct:
+	ecm_db_fib_rule_notifier_stop();
 #ifdef ECM_IPV6_ENABLE
@@ -310,3 +311,4 @@
 err_fe_ipv6:
 #endif
+	ecm_db_fib_rule_notifier_stop();
 	ecm_front_end_ipv4_exit();
@@ -313,2 +315,3 @@
 err_fe_ipv4:
+	ecm_db_fib_rule_notifier_stop();
 #ifdef ECM_INTERFACE_BOND_ENABLE
@@ -381,8 +384,9 @@
 static void __exit ecm_exit(void)
 {
 	printk(KERN_INFO "ECM exit\n");
 
 	/* call stop on anything that requires a prepare-to-exit signal */
+	ecm_db_fib_rule_notifier_stop();
 	DEBUG_INFO("stop conntrack notifier\n");
 	ecm_conntrack_notifier_stop(1);
 	DEBUG_INFO("stop front_end_ipv4\n");
diff --git a/frontends/ecm_front_end_ipv4.c b/frontends/ecm_front_end_ipv4.c
--- a/frontends/ecm_front_end_ipv4.c
+++ b/frontends/ecm_front_end_ipv4.c
@@ -58,8 +58,4 @@
 extern int ecm_front_end_ipv4_stopped;	/* When non-zero further traffic will not be processed */
 
-/*
- * Temporary operational control
- */
-atomic_t ecm_front_end_ipv4_stopped_temp = ATOMIC_INIT(0);	/* When non-zero further traffic/process will not be processed where it is checked */
 
 /*
@@ -428,19 +424,6 @@
 }
 
-/*
- * ecm_front_end_ipv4_stop_temp()
- */
-void ecm_front_end_ipv4_stop_temp(int num)
-{
-	if (num) {
-		atomic_inc(&ecm_front_end_ipv4_stopped_temp);
-	} else {
-		if (atomic_read(&ecm_front_end_ipv4_stopped_temp) > 0) {
-			atomic_dec(&ecm_front_end_ipv4_stopped_temp);
-		}
-	}
-}
 
